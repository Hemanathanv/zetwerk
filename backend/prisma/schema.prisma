  issuerCompanyName String? @map("issuer_company_name")
  issuerAddress     String? @map("issuer_address")
  issuerPhone       String? @map("issuer_phone")
  issuerEmail       String? @map("issuer_email")
  issuerWebsite     String? @map("issuer_website")
  issuerVatNumber   String? @map("issuer_vat_number")
  issuerGstNumber   String? @map("issuer_gst_number")
  issuerPanNumber   String? @map("issuer_pan_number")
  issuerCinNumber   String? @map("issuer_cin_number")
  issuerLutNumber   String? @map("issuer_lut_number")
  issuerTanNumber   String? @map("issuer_tan_number")

  // Invoice Identification
  invoiceNumber   String? @map("invoice_number")
  invoiceDate     String? @map("invoice_date")
  dueDate         String? @map("due_date")
  paymentTerms    String? @map("payment_terms")
  payReference    String? @map("pay_reference")
  customerId      String? @map("customer_id")
  shipmentNumber  String? @map("shipment_number")
  consolNumber    String? @map("consol_number")
  jobNumber       String? @map("job_number")
  jobDate         String? @map("job_date")
  irn             String?
  documentVariant String? @map("document_variant")
  subInvoiceIndex String? @map("sub_invoice_index")

  // Customer
  customerName      String? @map("customer_name")
  customerAddress   String? @map("customer_address")
  customerAgentCode String? @map("customer_agent_code")

  // Shipment
