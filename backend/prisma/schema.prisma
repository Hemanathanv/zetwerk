// FIX #4 #5 — Added back-relations for ExtractionLog and AiUsageRecord
model DocumentPage {
  id                 String   @id @default(uuid())
  documentId         String   @map("document_id")
  pageNo             Int      @map("page_no")
  bucket             String
  objectKey          String   @map("object_key")
  width              Int?
  height             Int?
  sizeBytes          BigInt?  @map("size_bytes")
  rawText            String?  @map("raw_text")
  isExtractionSource Boolean  @default(false) @map("is_extraction_source")
  createdAt          DateTime @default(now()) @map("created_at")

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionLogs ExtractionLog[] // FIX #5
  usageRecords   AiUsageRecord[] // FIX #4

  @@unique([documentId, pageNo])
  @@index([documentId])
  @@schema("public")
  @@map("document_pages")
}

// FIX #9 — DocumentVersion model was missing from paste.txt, restored here
