generator client {
  provider            = "prisma-client-py"
  interface           = "asyncio"
  enable_experimental_decimal = true
  recursive_type_depth = 5
  previewFeatures      = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth","public","dashboard","aiextraction"]
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------
// AUTH - SCHEMA
// -----------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  USER

  @@schema("auth")
}

// S3 / IAM permission level per bucket
enum S3Permission {
  READ
  WRITE
  READ_WRITE
  ADMIN

  @@schema("auth")
}


model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         SystemRole  @default(USER) @map("system_role")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  profile      Profile?
  sessions     Session[]
  s3Credentials S3UserCredential[]  // ← SeaweedFS IAM credentials
  s3Policies   S3UserPolicy[]       // ← per-bucket RBAC policies

  @@index([role])
  @@schema("auth")
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  phone       String?
  department  String?
  designation String?
  avatarUrl   String?   @map("avatar_url")
  bio         String?
  location    String?
  timezone    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
  @@map("profiles")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@schema("auth")
  @@map("sessions")
}

model S3UserCredential {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  accessKeyId String   @unique @map("access_key_id")  // SeaweedFS IAM access key
  // NOTE: secretKey is NEVER stored here — returned once at creation
  // Store a hashed hint only if needed for display
  keyHint     String?  @map("key_hint")               // last 4 chars of secret (optional)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")             // optional key rotation date

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessKeyId])
  @@schema("auth")
  @@map("s3_user_credentials")
}

model S3UserPolicy {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  bucket     String                          // e.g. "ewms-invoices"
  permission S3Permission                    // READ / WRITE / READ_WRITE / ADMIN
  grantedBy  String       @map("granted_by") // userId of admin who granted
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket])                 // one policy per user per bucket
  @@index([userId])
  @@index([bucket])
  @@schema("auth")
  @@map("s3_user_policies")
}


// -----------------------------------------------------------------
// PUBLIC - SCHEMA
// -----------------------------------------------------------------


enum DocType {
  SALES_INVOICE
  BILL_OF_LADING
  PACKING_LIST
  ENTRY_SUMMARY
  ENTRY_SUMMARY_TARIFF_LINES
  OCEAN_FREIGHT
  FREIGHT_FORWARDER_BILL
  US_CARGO_RELEASE_ORDER
  US_CUSTOMS_RELEASE_ORDER
  US_DELIVERY_ORDER
  US_PACKING_LIST
  SHIPPING_BILL
  CHA_BILL
  @@schema("public")
}

// FIX #7 — DocumentStatus was used but never defined
enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  EXTRACTED
  REVIEWED
  REJECTED
  REPROCESSING
  ARCHIVED
  @@schema("public")
}


model Document {
  id          String         @id @default(uuid())
  docType     DocType        @map("doc_type")
  status      DocumentStatus @default(UPLOADED)

  bucket      String
  objectKey   String         @map("object_key")
  fileName    String         @map("file_name")
  contentType String         @map("content_type")
  sizeBytes   BigInt         @map("size_bytes")
  checksum    String?
  totalPages  Int?           @map("total_pages")

  uploadedBy  String         @map("uploaded_by")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Core relations (public schema)
  pages          DocumentPage[]
  versions       DocumentVersion[]
  extractionLogs ExtractionLog[]
  usageRecords   AiUsageRecord[]

  // Typed extraction back-relations (aiextraction schema — required by Prisma)
  bolExtraction                    BillOfLading?
  salesInvoiceExtraction           SalesInvoiceExtraction?
  entrySummaryExtraction           EntrySummaryExtraction?
  entrySummaryTariffLineExtraction EntrySummaryTariffLineExtraction?
  oceanFreightExtraction           OceanFreightExtraction?
  packingListExtraction            PackingListExtraction?
  freightForwarderBillExtraction   FreightForwarderBillExtraction?
  usCargoReleaseExtraction         UsCargoReleaseExtraction?
  usCustomsReleaseExtraction       UsCustomsReleaseExtraction?
  usDeliveryOrderExtraction        UsDeliveryOrderExtraction?
  usPackingListExtraction          UsPackingListExtraction?
  shippingBillExtraction           ShippingBillExtraction?
  chaBillExtraction                ChaBillExtraction?


  @@index([docType])
  @@index([status])
  @@index([uploadedBy])
  @@schema("public")
  @@map("documents")
}

// FIX #4 #5 — Added back-relations for ExtractionLog and AiUsageRecord
model DocumentPage {
  id                 String   @id @default(uuid())
  documentId         String   @map("document_id")
  pageNo             Int      @map("page_no")
  bucket             String
  objectKey          String   @map("object_key")
  width              Int?
  height             Int?
  sizeBytes          BigInt?  @map("size_bytes")
  rawText            String?  @map("raw_text")
  isExtractionSource Boolean  @default(false) @map("is_extraction_source")
  createdAt          DateTime @default(now()) @map("created_at")

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionLogs ExtractionLog[] // FIX #5
  usageRecords   AiUsageRecord[] // FIX #4

  @@unique([documentId, pageNo])
  @@index([documentId])
  @@schema("public")
  @@map("document_pages")
}

// FIX #9 — DocumentVersion model was missing from paste.txt, restored here
model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  versionNo  Int      @map("version_no")
  bucket     String
  objectKey  String   @map("object_key")
  fileName   String   @map("file_name")
  sizeBytes  BigInt   @map("size_bytes")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@schema("public")
  @@map("document_versions")
}


// -----------------------------------------------------------------
// AIEXTRACTION - SCHEMA
// -----------------------------------------------------------------

enum ExtractionTaskStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  @@schema("aiextraction")
}

enum ExtractionConfidence {
  HIGH
  MEDIUM
  LOW
  @@schema("aiextraction")
}

model ExtractionLog {
  id             String               @id @default(uuid())
  documentId     String               @map("document_id")
  pageId         String?              @map("page_id")       // null = full-doc run
  celeryTaskId   String?              @unique @map("celery_task_id")
  model          String                                     // gemini-2.0-flash / qwen-vl
  status         ExtractionTaskStatus @default(QUEUED)
  confidence     ExtractionConfidence?
  tokensUsed     Int?                 @map("tokens_used")
  processingMs   Int?                 @map("processing_ms")
  errorMessage   String?              @map("error_message")
  retryCount     Int                  @default(0) @map("retry_count")
  isLatest       Boolean              @default(true) @map("is_latest") // latest run flag
  triggeredBy    String?              @map("triggered_by")  // userId or "system"
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")

  document       Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page           DocumentPage?        @relation(fields: [pageId], references: [id])

  @@index([documentId])
  @@index([pageId])
  @@index([status])
  @@index([isLatest])
  @@schema("aiextraction")
  @@map("extraction_logs")
}



model AiModelRegistry {
  id                  String    @id @default(uuid())
  modelId             String    @unique @map("model_id")         // e.g. "gemini-2.0-flash"
  provider            String                                     // google / openai / alibaba / local
  displayName         String    @map("display_name")             // "Gemini 2.0 Flash"
  version             String?                                    // "2.0", "72b" etc.
  isActive            Boolean   @default(true) @map("is_active") // disable old models
  isLocal             Boolean   @default(false) @map("is_local") // Ollama / vLLM = no cost

  // Pricing (USD per 1M tokens — snapshot, update when provider changes)
  inputPricePer1M     Decimal   @map("input_price_per_1m")       // e.g. 0.10 for Gemini Flash
  outputPricePer1M    Decimal   @map("output_price_per_1m")      // e.g. 0.40 for Gemini Flash
  imagePricePer1K     Decimal?  @map("image_price_per_1k")       // for vision models (per 1K images)
  contextWindowTokens Int?      @map("context_window_tokens")    // max context size
  supportsVision      Boolean   @default(false) @map("supports_vision")
  supportsOcr         Boolean   @default(false) @map("supports_ocr")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // All usage records for this model
  usageRecords        AiUsageRecord[]

  @@index([provider])
  @@index([isActive])
  @@schema("aiextraction")
  @@map("ai_model_registry")
}


model AiUsageRecord {
  id                    String    @id @default(uuid())

  // What was processed
  documentId            String    @map("document_id")
  pageId                String?   @map("page_id")         // null = full-doc call
  extractionLogId       String?   @map("extraction_log_id") // link to Celery task

  // Which model
  modelRegistryId       String    @map("model_registry_id")
  modelId               String    @map("model_id")         // snapshot: "gemini-2.0-flash"
  provider              String                             // snapshot: "google"

  // Token counts (from API response)
  inputTokens           Int       @map("input_tokens")
  outputTokens          Int       @map("output_tokens")
  totalTokens           Int       @map("total_tokens")     // input + output
  imageCount            Int?      @default(0) @map("image_count") // for vision calls

  // Cost calculation (USD) — computed at insert time, stored for fast reporting
  snapshotInputPrice    Decimal   @map("snapshot_input_price")   // per 1M at call time
  snapshotOutputPrice   Decimal   @map("snapshot_output_price")  // per 1M at call time
  inputCostUsd          Decimal   @map("input_cost_usd")
  outputCostUsd         Decimal   @map("output_cost_usd")
  imageCostUsd          Decimal   @default(0) @map("image_cost_usd")
  totalCostUsd          Decimal   @map("total_cost_usd")

  // Call metadata
  docType               DocType   @map("doc_type")          // for cost-per-doctype reporting
  taskType              String    @map("task_type")          // extraction / ocr / validation / retry
  processingMs          Int?      @map("processing_ms")
  isRetry               Boolean   @default(false) @map("is_retry")
  promptVersion         String?   @map("prompt_version")    // e.g. "bol-v3" — track prompt changes

  calledAt              DateTime  @default(now()) @map("called_at")

  // Relations
  document              Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page                  DocumentPage?   @relation(fields: [pageId], references: [id])
  modelRegistry         AiModelRegistry @relation(fields: [modelRegistryId], references: [id])

  @@index([documentId])
  @@index([pageId])
  @@index([modelId])
  @@index([docType])
  @@index([calledAt])
  @@index([taskType])
  @@schema("aiextraction")
  @@map("ai_usage_records")
}

model BillOfLading {
  id                  String    @id @default(uuid())
  documentId          String    @unique @map("document_id")

  bolNumber               String? @map("bol_number")
  shipmentReferenceNumber String? @map("shipment_reference_number")
  negotiability           String?
  projectName             String? @map("project_name")
  shipsRemarks            String? @map("ships_remarks")
  documentCategory        String? @map("document_category")

  // Carrier
  carrierCompanyName          String? @map("carrier_company_name")
  carrierMtoRegistrationNumber String? @map("carrier_mto_registration_number")
  carrierFmcNumber            String? @map("carrier_fmc_number")

  // Shipper
  shipperName    String? @map("shipper_name")
  shipperAddress String? @map("shipper_address")

  // Consignee
  consigneeName        String? @map("consignee_name")
  consigneeAddress     String? @map("consignee_address")
  consigneeContactName String? @map("consignee_contact_name")
  consigneePhone       String? @map("consignee_phone")
  consigneeEmail       String? @map("consignee_email")

  // Notify Party
  notifyPartyName    String? @map("notify_party_name")
  notifyPartyAddress String? @map("notify_party_address")
  notifyPartyEmail   String? @map("notify_party_email")
  notifyPartyPhone   String? @map("notify_party_phone")

  // Second Notify
  secondNotifyName    String? @map("second_notify_name")
  secondNotifyAddress String? @map("second_notify_address")

  // Delivery Agent
  deliveryAgentName    String? @map("delivery_agent_name")
  deliveryAgentAddress String? @map("delivery_agent_address")
  deliveryAgentPhone   String? @map("delivery_agent_phone")
  deliveryAgentEmail   String? @map("delivery_agent_email")

  // Routing
  placeOfAcceptance String? @map("place_of_acceptance")
  portOfLoading     String? @map("port_of_loading")
  placeOfReceipt    String? @map("place_of_receipt")
  countryOfOrigin   String? @map("country_of_origin")
  portOfDischarge   String? @map("port_of_discharge")
  finalDestination  String? @map("final_destination")
  placeOfDelivery   String? @map("place_of_delivery")
  transhipmentPlace String? @map("transhipment_place")

  // Vessel
  vesselName         String? @map("vessel_name")
  vesselVoyageNumber String? @map("vessel_voyage_number")
  shippedOnBoardDate String? @map("shipped_on_board_date")
  vesselCarrierName  String? @map("vessel_carrier_name")

  // Cargo
  marksAndNumbers  String? @map("marks_and_numbers")
  packageSummary   String? @map("package_summary")
  totalPackages    String? @map("total_packages")
  totalContainers  String? @map("total_containers")
  goodsDescription String? @map("goods_description")
  grossWeight      String? @map("gross_weight")
  grossWeightUnit  String? @map("gross_weight_unit")
  netWeight        String? @map("net_weight")
  netWeightUnit    String? @map("net_weight_unit")
  measurementCbm   String? @map("measurement_cbm")
  usHsnc           String? @map("us_hsnc")
  iecNumber        String? @map("iec_number")

  // Freight
  freightAmount    String? @map("freight_amount")
  freightPayableAt String? @map("freight_payable_at")
  freightType      String? @map("freight_type")
  fobCharges       String? @map("fob_charges")

  // Issuance
  issuancePlace     String? @map("issuance_place")
  issuanceDate      String? @map("issuance_date")
  numberOfOriginals String? @map("number_of_originals")
  charterPartyDate  String? @map("charter_party_date")

  // Export Invoice (scalar — first/primary entry)
  exportInvoiceNumber String? @map("export_invoice_number")
  exportInvoiceDate   String? @map("export_invoice_date")

  // Export Shipping Bill (scalar — first/primary entry)
  exportShippingBillNumber String? @map("export_shipping_bill_number")
  exportShippingBillDate   String? @map("export_shipping_bill_date")

  // Array sections
  exportInvoices Json? @map("export_invoices")
  containers     Json?
  shippingBills  Json? @map("shipping_bills")

  rawData             Json?     @map("raw_data")            // full AI dump
  extractedAt         DateTime? @map("extracted_at")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([bolNumber])
  @@schema("aiextraction")
  @@map("bills_of_lading")
}

