model ChaBillExtraction {
  id                  String    @id @default(uuid())
  documentId          String    @unique @map("document_id")

  // Document classification
  documentType String? @map("document_type")
  taxType      String? @map("tax_type")

  // Issuer
  issuerCompanyName String? @map("issuer_company_name")
  issuerAddress     String? @map("issuer_address")
  issuerCin         String? @map("issuer_cin")
  issuerPan         String? @map("issuer_pan")
  issuerGstin       String? @map("issuer_gstin")
  issuerPhone       String? @map("issuer_phone")
  issuerEmail       String? @map("issuer_email")
  issuerWebsite     String? @map("issuer_website")
  issuerMsmeUdyam   String? @map("issuer_msme_udyam")
  issuerStateCode   String? @map("issuer_state_code")

  // Invoice Identification
  documentTitle String? @map("document_title")
  invoiceNumber String? @map("invoice_number")
  invoiceDate   String? @map("invoice_date")
  dueDate       String? @map("due_date")
  paymentTerms  String? @map("payment_terms")
  copyType      String? @map("copy_type")
  irn           String?
  irnAckNumber  String? @map("irn_ack_number")
  irnAckTime    String? @map("irn_ack_time")

  // Customer / Bill-To
  customerName           String? @map("customer_name")
  customerAddress        String? @map("customer_address")
  customerGstin          String? @map("customer_gstin")
  customerPan            String? @map("customer_pan")
  customerCustomerId     String? @map("customer_customer_id")
  customerStateCode      String? @map("customer_state_code")
  customerStateOfSupply  String? @map("customer_state_of_supply")
  customerPlaceOfSupply  String? @map("customer_place_of_supply")
  customerReverseCharge  String? @map("customer_reverse_charge")
  customerShipmentNumber String? @map("customer_shipment_number")

  // Shipment / Routing
  shipmentShipper             String? @map("shipment_shipper")
  shipmentShipperAddress      String? @map("shipment_shipper_address")
  shipmentConsignee           String? @map("shipment_consignee")
  shipmentConsigneeAddress    String? @map("shipment_consignee_address")
  shipmentOrderReference      String? @map("shipment_order_reference")
  shipmentIncoterm            String? @map("shipment_incoterm")
  shipmentGoodsDescription    String? @map("shipment_goods_description")
  shipmentCommodityNote       String? @map("shipment_commodity_note")
  shipmentGrossWeight         String? @map("shipment_gross_weight")
  shipmentGrossWeightUnit     String? @map("shipment_gross_weight_unit")
  shipmentVolume              String? @map("shipment_volume")
  shipmentChargeableWeight    String? @map("shipment_chargeable_weight")
  shipmentPackages            String? @map("shipment_packages")
  shipmentVesselVoyageImo     String? @map("shipment_vessel_voyage_imo")
  shipmentVesselName          String? @map("shipment_vessel_name")
  shipmentMbl                 String? @map("shipment_mbl")
  shipmentHbl                 String? @map("shipment_hbl")
  shipmentImportCustomsBroker String? @map("shipment_import_customs_broker")
  shipmentOrigin              String? @map("shipment_origin")
  shipmentEtd                 String? @map("shipment_etd")
  shipmentDestination         String? @map("shipment_destination")
  shipmentEta                 String? @map("shipment_eta")

  // Job / Reference (Benevlog format)
  jobNumber      String? @map("job_number")
  jobDate        String? @map("job_date")
  jobDocNumber   String? @map("job_doc_number")
  jobPolPod      String? @map("job_pol_pod")
  jobProjectName String? @map("job_project_name")
  jobPreparedBy  String? @map("job_prepared_by")
  jobApprovedBy  String? @map("job_approved_by")

  // Containers
  containersRaw String? @map("containers_raw")
  containers    Json?

  // Repeating arrays
  charges    Json?
  taxSummary Json? @map("tax_summary")

  // Totals
  totalsSubtotal           String? @map("totals_subtotal")
  totalsIgstAmount         String? @map("totals_igst_amount")
  totalsCgstAmount         String? @map("totals_cgst_amount")
  totalsSgstAmount         String? @map("totals_sgst_amount")
  totalsGrandTotalInr      String? @map("totals_grand_total_inr")
  totalsInvoiceAmountPage2 String? @map("totals_invoice_amount_page2")
  totalsAmountInWords      String? @map("totals_amount_in_words")
  totalsNetAmount          String? @map("totals_net_amount")

  // Bank Details (array — multiple accounts possible)
  bankDetails Json? @map("bank_details")

  // Additional
  lutBondReference String? @map("lut_bond_reference")
  digitalSignature String? @map("digital_signature")
  bookingNumber    String? @map("booking_number")
  remarks          String?

  // QR Code (GST e-Invoice JWT decoded)
  qrRawJwt             String? @map("qr_raw_jwt")
  qrIssuer             String? @map("qr_issuer")
  qrSellerGstin        String? @map("qr_seller_gstin")
  qrBuyerGstin         String? @map("qr_buyer_gstin")
  qrDocNo              String? @map("qr_doc_no")
  qrDocType            String? @map("qr_doc_type")
  qrDocDate            String? @map("qr_doc_date")
  qrTotalInvValue      String? @map("qr_total_inv_value")
  qrItemCount          String? @map("qr_item_count")
  qrMainHsnCode        String? @map("qr_main_hsn_code")
  qrIrn                String? @map("qr_irn")
  qrIrnDate            String? @map("qr_irn_date")
  qrSignatureAlgorithm String? @map("qr_signature_algorithm")

  // Extraction metadata
  extractionConfidence String? @map("extraction_confidence")
  flags                Json?

  rawData             Json?     @map("raw_data")            // full AI dump
  extractedAt         DateTime? @map("extracted_at")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("aiextraction")
  @@index([invoiceNumber], map: "idx_cha_bill_invoice_number")
  @@map("cha_bill_extractions")
}

