  @@map("dnd_shipment_inputs")
}


// -----------------------------------------------------------------
// AIEXTRACTION - SCHEMA
// -----------------------------------------------------------------

enum ExtractionTaskStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  @@schema("aiextraction")
}

enum ExtractionConfidence {
  HIGH
  MEDIUM
  LOW
  @@schema("aiextraction")
}

model ExtractionLog {
  id             String               @id @default(uuid())
  documentId     String               @map("document_id")
  pageId         String?              @map("page_id")       // null = full-doc run
  celeryTaskId   String?              @unique @map("celery_task_id")
  model          String                                     // gemini-2.0-flash / qwen-vl
  status         ExtractionTaskStatus @default(QUEUED)
  confidence     ExtractionConfidence?
  tokensUsed     Int?                 @map("tokens_used")
  processingMs   Int?                 @map("processing_ms")
  errorMessage   String?              @map("error_message")
  retryCount     Int                  @default(0) @map("retry_count")
  isLatest       Boolean              @default(true) @map("is_latest") // latest run flag
  triggeredBy    String?              @map("triggered_by")  // userId or "system"
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")

  document       Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page           DocumentPage?        @relation(fields: [pageId], references: [id])

