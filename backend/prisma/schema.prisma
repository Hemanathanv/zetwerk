model AiModelRegistry {
  id                  String    @id @default(uuid())
  modelId             String    @unique @map("model_id")         // e.g. "gemini-2.0-flash"
  provider            String                                     // google / openai / alibaba / local
  displayName         String    @map("display_name")             // "Gemini 2.0 Flash"
  version             String?                                    // "2.0", "72b" etc.
  isActive            Boolean   @default(true) @map("is_active") // disable old models
  isLocal             Boolean   @default(false) @map("is_local") // Ollama / vLLM = no cost

  // Pricing (USD per 1M tokens — snapshot, update when provider changes)
  inputPricePer1M     Decimal   @map("input_price_per_1m")       // e.g. 0.10 for Gemini Flash
  outputPricePer1M    Decimal   @map("output_price_per_1m")      // e.g. 0.40 for Gemini Flash
  imagePricePer1K     Decimal?  @map("image_price_per_1k")       // for vision models (per 1K images)
  contextWindowTokens Int?      @map("context_window_tokens")    // max context size
  supportsVision      Boolean   @default(false) @map("supports_vision")
  supportsOcr         Boolean   @default(false) @map("supports_ocr")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // All usage records for this model
  usageRecords        AiUsageRecord[]

  @@index([provider])
  @@index([isActive])
  @@schema("aiextraction")
  @@map("ai_model_registry")
}


model AiUsageRecord {
  id                    String    @id @default(uuid())

  // What was processed
  documentId            String    @map("document_id")
  pageId                String?   @map("page_id")         // null = full-doc call
  extractionLogId       String?   @map("extraction_log_id") // link to Celery task

  // Which model
  modelRegistryId       String    @map("model_registry_id")
  modelId               String    @map("model_id")         // snapshot: "gemini-2.0-flash"
  provider              String                             // snapshot: "google"

  // Token counts (from API response)
  inputTokens           Int       @map("input_tokens")
  outputTokens          Int       @map("output_tokens")
  totalTokens           Int       @map("total_tokens")     // input + output
  imageCount            Int?      @default(0) @map("image_count") // for vision calls

  // Cost calculation (USD) — computed at insert time, stored for fast reporting
  snapshotInputPrice    Decimal   @map("snapshot_input_price")   // per 1M at call time
  snapshotOutputPrice   Decimal   @map("snapshot_output_price")  // per 1M at call time
  inputCostUsd          Decimal   @map("input_cost_usd")
  outputCostUsd         Decimal   @map("output_cost_usd")
  imageCostUsd          Decimal   @default(0) @map("image_cost_usd")
  totalCostUsd          Decimal   @map("total_cost_usd")

  // Call metadata
  docType               DocType   @map("doc_type")          // for cost-per-doctype reporting
  taskType              String    @map("task_type")          // extraction / ocr / validation / retry
  processingMs          Int?      @map("processing_ms")
  isRetry               Boolean   @default(false) @map("is_retry")
  promptVersion         String?   @map("prompt_version")    // e.g. "bol-v3" — track prompt changes

  calledAt              DateTime  @default(now()) @map("called_at")

  // Relations
  document              Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page                  DocumentPage?   @relation(fields: [pageId], references: [id])
  modelRegistry         AiModelRegistry @relation(fields: [modelRegistryId], references: [id])

  @@index([documentId])
  @@index([pageId])
  @@index([modelId])
  @@index([docType])
  @@index([calledAt])
  @@index([taskType])
  @@schema("aiextraction")
  @@map("ai_usage_records")
}

