model SafeCubeShipment {
  id                String   @id @default(uuid())
  shipmentNumber    String   @unique @map("shipment_number")
  shipmentType      String?  @map("shipment_type")
  sealine           String?
  status            String?
  currentStage      Int      @default(1) @map("current_stage")
  currentStageName  String?  @map("current_stage_name")
  currentLocation   Json?    @map("current_location")
  liveCoordinates   Json?    @map("live_coordinates")
  ais               Json?
  route             Json?
  locations         Json?
  vessels           Json?
  containers        Json?
  rawData           Json?    @map("raw_data")
  fetchedAt         DateTime @default(now()) @map("fetched_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  events            SafeCubeTrackingEvent[]

  @@index([shipmentNumber])
  @@index([status])
  @@index([fetchedAt])
  @@schema("dashboard")
  @@map("safecube_shipments")
}

model SafeCubeTrackingEvent {
  id              String            @id @default(uuid())
  shipmentId      String            @map("shipment_id")
  containerNumber String?           @map("container_number")
  eventCode       String?           @map("event_code")
  status          String?
  description     String?
  location        Json?
  facility        Json?
  occurredAt      DateTime?         @map("occurred_at")
  isActual        Boolean?          @map("is_actual")
  rawData         Json?             @map("raw_data")
  createdAt       DateTime          @default(now()) @map("created_at")

  shipment        SafeCubeShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([containerNumber])
  @@index([occurredAt])
  @@schema("dashboard")
  @@map("safecube_tracking_events")
}
