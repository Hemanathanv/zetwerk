  postalCode       String? @map("postal_code")
  country          String?
  poNumber         String? @map("po_number")
  htsCode          String? @map("hts_code")
  productCode      String? @map("product_code")
  countryOfOrigin  String? @map("country_of_origin")

  isfExtraction IsfExtraction @relation(fields: [isfExtractionId], references: [id], onDelete: Cascade)

  @@index([isfExtractionId])
  @@schema("aiextraction")
  @@map("isf_manufacturers")
}



