  warningPct        Int      @default(50) @map("warning_pct")
  escalationPct     Int      @default(75) @map("escalation_pct")
  blockerPct        Int      @default(100) @map("blocker_pct")
  taskEnabled       Boolean  @default(true) @map("task_enabled")
  triggerCategory   String?  @map("trigger_category")
  triggerLogic      String?  @map("trigger_logic")
