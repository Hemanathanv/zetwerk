  freightCountedShipperConfirmed String? @map("freight_counted_shipper_confirmed")
  trailerLoadedDriverConfirmed   String? @map("trailer_loaded_driver_confirmed")
  freightCountedDriverConfirmed  String? @map("freight_counted_driver_confirmed")

  // Totals
  totalLines            String? @map("total_lines")
  totalPiecesAggregate  String? @map("total_pieces_aggregate")
  totalBundlesAggregate String? @map("total_bundles_aggregate")
  totalWeightLbs        String? @map("total_weight_lbs")
  grossWeightUnit       String? @map("gross_weight_unit")

  // Signatures
  receivedByName       String? @map("received_by_name")
  shipperSignature     String? @map("shipper_signature")
  shipperSignatureDate String? @map("shipper_signature_date")
  carrierSignature     String? @map("carrier_signature")
  carrierSignatureDate String? @map("carrier_signature_date")

  // Compliance
  liabilityLimitationNotice    String? @map("liability_limitation_notice")
  conditionStatement           String? @map("condition_statement")
  propertyValueDeclaredShipper String? @map("property_value_declared_shipper")

  // Line Items (array)
  lineItems Json? @map("line_items")

  rawData             Json?     @map("raw_data")            // full AI dump
  extractedAt         DateTime? @map("extracted_at")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("aiextraction")
  @@index([packingSlipNumber], map: "idx_us_packing_list_slip_number")
  @@map("us_packing_list_extractions")
}


