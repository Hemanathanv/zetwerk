model EntrySummaryTariffLineExtraction {
  id                  String    @id @default(uuid())
  documentId          String    @unique @map("document_id")

  // Header
  filerCodeEntryNumber String? @map("filer_code_entry_number")

  // General (line-level context)
  lineNo                     String? @map("line_no")
  lineMerchandiseDescription String? @map("line_merchandise_description")
  lineHtsusNumber            String? @map("line_htsus_number")

  // Tariff Lines (array — one object per tariff sub-line)
  tariffLines Json? @map("tariff_lines")

  rawData             Json?     @map("raw_data")            // full AI dump
  extractedAt         DateTime? @map("extracted_at")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("aiextraction")
  @@index([filerCodeEntryNumber], map: "idx_es_tariff_entry_number")
  @@map("entry_summary_tariff_line_extractions")
}

model OceanFreightExtraction {
