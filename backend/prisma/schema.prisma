generator client {
  provider            = "prisma-client-py"
  interface           = "asyncio"
  enable_experimental_decimal = true
  recursive_type_depth = 5
  previewFeatures      = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth","public","dashboard","aiextraction","docgen","project"]
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------
// AUTH - SCHEMA
// -----------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  USER

  @@schema("auth")
}

// S3 / IAM permission level per bucket
enum S3Permission {
  READ
  WRITE
  READ_WRITE
  ADMIN

  @@schema("auth")
}


model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         SystemRole  @default(USER) @map("system_role")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  profile      Profile?
  sessions     Session[]
  s3Credentials S3UserCredential[]  // ← SeaweedFS IAM credentials
  s3Policies   S3UserPolicy[]       // ← per-bucket RBAC policies

  @@index([role])
  @@schema("auth")
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  phone       String?
  department  String?
  designation String?
  avatarUrl   String?   @map("avatar_url")
  bio         String?
  location    String?
  timezone    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
  @@map("profiles")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@schema("auth")
  @@map("sessions")
}

model S3UserCredential {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  accessKeyId String   @unique @map("access_key_id")  // SeaweedFS IAM access key
  // NOTE: secretKey is NEVER stored here — returned once at creation
  // Store a hashed hint only if needed for display
  keyHint     String?  @map("key_hint")               // last 4 chars of secret (optional)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")             // optional key rotation date

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessKeyId])
  @@schema("auth")
  @@map("s3_user_credentials")
}

model S3UserPolicy {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  bucket     String                          // e.g. "ewms-invoices"
  permission S3Permission                    // READ / WRITE / READ_WRITE / ADMIN
  grantedBy  String       @map("granted_by") // userId of admin who granted
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket])                 // one policy per user per bucket
  @@index([userId])
  @@index([bucket])
  @@schema("auth")
  @@map("s3_user_policies")
}


// -----------------------------------------------------------------
// PUBLIC - SCHEMA
// -----------------------------------------------------------------


enum DocType {
  SALES_INVOICE
  BILL_OF_LADING
  PACKING_LIST
  ENTRY_SUMMARY
  DRAFT_CBP_FORM_7501_BROKER
  OCEAN_FREIGHT
  FREIGHT_FORWARDER_BILL
  CUSTOMER_BROKER_BILL
  GRN_INBOUND
  PORT_TO_WH
  WH_TO_CUSTOMER
  US_SALES_INVOICE
  US_CARGO_RELEASE_ORDER
  US_CUSTOMS_RELEASE_ORDER
  US_DELIVERY_ORDER
  US_PACKING_LIST
  OUTWARD_GRN
  ISF
  SHIPPING_BILL
  CHA_BILL
  @@schema("public")
}

// FIX #7 — DocumentStatus was used but never defined
enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  EXTRACTED
  REVIEWED
  REJECTED
  REPROCESSING
  ARCHIVED
  @@schema("public")
}

enum DocGenerationStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  GENERATED
  ARCHIVED

  @@schema("docgen")
}

enum DocGenerationMappingType {
  direct
  derived
  contextual
  manual
  conditional

  @@schema("docgen")
}

enum DocGenerationSeverity {
  critical
  warning
  info

  @@schema("docgen")
}


model Document {
  id          String         @id @default(uuid())
  docType     DocType        @map("doc_type")
  status      DocumentStatus @default(UPLOADED)

  bucket      String
  objectKey   String         @map("object_key")
  fileName    String         @map("file_name")
  contentType String         @map("content_type")
  sizeBytes   BigInt         @map("size_bytes")
  checksum    String?
  totalPages  Int?           @map("total_pages")

  uploadedBy  String         @map("uploaded_by")
  isDeleted   Boolean        @default(false) @map("is_deleted")
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Core relations (public schema)
  pages          DocumentPage[]
  versions       DocumentVersion[]
  extractionLogs ExtractionLog[]
  usageRecords   AiUsageRecord[]

  // Typed extraction back-relations (aiextraction schema — required by Prisma)
  bolExtraction                    BillOfLading?
  salesInvoiceExtraction           SalesInvoiceExtraction?
  entrySummaryExtraction           EntrySummaryExtraction?
  oceanFreightExtraction           OceanFreightExtraction?
  packingListExtraction            PackingListExtraction?
  freightForwarderBillExtraction   FreightForwarderBillExtraction?
  customerBrokerBillExtraction     CustomerBrokerBillExtraction?
  grnInboundExtraction             GrnInboundExtraction?
  portToWhExtraction               PortToWhExtraction?
  whToCustomerExtraction           WhToCustomerExtraction?
  usSalesInvoiceExtraction         UsSalesInvoiceExtraction?
  usCargoReleaseExtraction         UsCargoReleaseExtraction?
  usCustomsReleaseExtraction       UsCustomsReleaseExtraction?
  usDeliveryOrderExtraction        UsDeliveryOrderExtraction?
  usPackingListExtraction          UsPackingListExtraction?
  isfExtraction                    IsfExtraction?
  shippingBillExtraction           ShippingBillExtraction?
  chaBillExtraction                ChaBillExtraction?


  @@index([docType])
  @@index([status])
  @@index([uploadedBy])
  @@schema("public")
  @@map("documents")
}


model Project {
  id            String                @id @default(uuid()) @db.Uuid
  projectName   String                @map("project_name")
  projectKey    String                @unique @map("project_key")
  customerName  String?               @map("customer_name")
  buyerOrgName  String?               @map("buyer_org_name")
  status        String                @default("ACTIVE")
  notes         String?
  shipmentCount Int                   @default(0) @map("shipment_count")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  shipments     OperationalShipment[]

  @@index([projectKey], map: "idx_projects_project_key")
  @@schema("project")
  @@map("projects")
}


model OperationalShipment {
  id               String    @id @default(uuid()) @db.Uuid
  shipmentNumber   String    @unique @map("shipment_number")
  status           String    @default("ACTIVE")
  blockedReason    String?   @map("blocked_reason")
  currentStage     Int       @default(1) @map("current_stage")
  currentStageName String?   @map("current_stage_name")
  workflowTemplateId String? @map("workflow_template_id") @db.Uuid
  vesselName       String?   @map("vessel_name")
  portOfLoading    String?   @map("port_of_loading")
  portOfDischarge  String?   @map("port_of_discharge")
  exporterName     String?   @map("exporter_name")
  buyerName        String?   @map("buyer_name")
  bolNumber        String?   @map("bol_number")
  mblNumber        String?   @map("mbl_number")
  bookingNumber    String?   @map("booking_number")
  loadType         String?   @map("load_type")
  incoterms        String?
  projectName      String?   @map("project_name")
  projectId        String?   @map("project_id") @db.Uuid
  etaPort          DateTime? @map("eta_port")
  etaDelivery      DateTime? @map("eta_delivery")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project          Project?  @relation(fields: [projectId], references: [id])

  @@index([shipmentNumber], map: "idx_shipments_number")
  @@index([projectId], map: "idx_shipments_project_id")
  @@index([projectName], map: "idx_shipments_project_name")
  @@schema("public")
  @@map("shipments")
}




model DocGenerationDraft {
  id               String              @id @default(uuid())
  generatedDocType String              @map("generated_doc_type")
  schemaVersion    Int                 @default(1) @map("schema_version")
  status           DocGenerationStatus @default(DRAFT)
  sourceDocumentIds Json                @map("source_document_ids")
  renderedPayload  Json?               @map("rendered_payload")
  createdBy        String              @map("created_by")
  confirmedBy      String?             @map("confirmed_by")
  confirmedAt      DateTime?           @map("confirmed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  allocations DocGenerationContainerAllocation[]
  lineItems   DocGenerationDraftLineItem[]

  @@index([generatedDocType])
  @@index([createdBy])
  @@index([status])
  @@schema("docgen")
  @@map("drafts")
}


model DocGenerationDraftLineItem {
  id        String   @id @default(uuid())
  draftId   String   @map("draft_id")
  lineNo    Int      @map("line_no")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  draft DocGenerationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([lineNo])
  @@schema("docgen")
  @@map("draft_line_items")
}


model DocGenerationContainerAllocation {
  id              String   @id @default(uuid())
  draftId         String   @map("draft_id")
  containerNumber String?  @map("container_number")
  sealNumber      String?  @map("seal_number")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  draft DocGenerationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([containerNumber])
  @@schema("docgen")
  @@map("container_allocations")
}

